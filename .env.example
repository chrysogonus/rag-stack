# Copy to .env (make install does this) and adjust.

# --- LLM provider ---------------------------------------------------------------------------
# Keep exactly one block below active. When switching, replace all five lines: a leftover
# LLM_BASE_URL would send requests to the wrong server.

# Local development: the subscription gateway (formerly sub2api; ~/workspace/subscription-gateway,
# started with `subscription-gateway serve`) on your ChatGPT subscription.
# A subscription login is for personal use only: the public deployment must use an API key.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_MODEL=codex/gpt-6-luna
EVAL_JUDGE_MODEL=codex/gpt-6-luna
LLM_API_KEY=

# OpenAI API:
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_MODEL=gpt-6-luna
# EVAL_JUDGE_MODEL=gpt-6-luna
# LLM_API_KEY=sk-...

# Anthropic API:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_MODEL=claude-sonnet-5-5
# EVAL_JUDGE_MODEL=claude-sonnet-5-5
# LLM_API_KEY=sk-ant-...

# Ollama (vLLM: http://127.0.0.1:8001/v1; LM Studio and other servers work the same way):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.3
# EVAL_JUDGE_MODEL=llama3.3
# LLM_API_KEY=

# Eval baseline: the chatbot `make eval` compares RAG answers against. Leave unset for the RAG
# model itself without retrieval; point it at a live general chatbot for that reference, e.g.
# the subscription gateway (whose Codex backend can search the web):
# EVAL_BASELINE_PROVIDER=openai-compatible
# EVAL_BASELINE_BASE_URL=http://127.0.0.1:11435/v1
# EVAL_BASELINE_MODEL=codex/gpt-6-luna
# EVAL_BASELINE_API_KEY=

# Eval judge: leave unset to judge on the provider above; or run it elsewhere, e.g. on the
# subscription gateway while the RAG model stays on the OpenAI API. A judge from another model
# family than the RAG model doesn't favor its answers: set
# EVAL_JUDGE_MODEL=claude-code/claude-haiku-5-5 (an exact model, not the moving
# `claude-code/haiku` alias, so runs stay comparable).
# EVAL_JUDGE_PROVIDER=openai-compatible
# EVAL_JUDGE_BASE_URL=http://127.0.0.1:11435/v1
# EVAL_JUDGE_API_KEY=

# Tracing: the self-hosted Langfuse from `make tracing` (keys created by docker-compose.yml).
# Unset, nothing is traced.
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local

DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/rag

# Limits for public, anonymous users
MAX_INPUT_CHARS=4000
MAX_HISTORY_MESSAGES=20
MAX_OUTPUT_TOKENS=4096
MAX_TURNS_PER_THREAD=50
RATE_LIMIT_PER_MINUTE=10
DAILY_TOKEN_BUDGET_PER_CLIENT=200000
# All clients together, so requests from many addresses can't run up unbounded cost
DAILY_TOKEN_BUDGET_TOTAL=5000000
# `make prune` deletes conversations and traces whose last activity is older than this
CONVERSATION_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30

# --- Knowledge base -------------------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=kb_chunks
# Open-weights models, downloaded on first use and run locally (fastembed, CPU)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-v2-m3-int8
RERANK_MAX_CHARS=800
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=8
RERANK_MIN_SCORE=0.0
MAX_CHUNK_CHARS=2500
# GPU models (optional, NVIDIA): embeddings and reranking on the vLLM services of the compose
# profile `gpu` (README, "GPU models"). A new embedding model rebuilds the index: `make refresh`.
# COMPOSE_PROFILES=gpu
# EMBEDDING_PROVIDER=vllm
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# RERANKER_PROVIDER=vllm
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# RERANKER_BASE_URL=http://127.0.0.1:8002/v1
# RERANK_MIN_SCORE=0.005
# Each service's share of the whole card; vLLM doesn't start unless that much is free.
# EMBEDDINGS_GPU_SHARE=0.37
# RERANKER_GPU_SHARE=0.16

# --- Ingestion ------------------------------------------------------------------------------
DATA_DIR=data
FETCH_USER_AGENT=rag-stack/0.1 (AI-security knowledge base ingest)
FETCH_CACHE_TTL_HOURS=24
# Optional: raises the NVD rate limit from 5 to 50 requests per 30 s (free key from nvd.nist.gov)
NVD_API_KEY=
# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour, so the advisories of the
# vulns source take minutes instead of over two hours (a fine-grained token with no permissions)
GITHUB_TOKEN=
