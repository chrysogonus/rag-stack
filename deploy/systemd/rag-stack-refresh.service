# Installed by `make schedule`, which fills in @REPO@, @PATH@ and @PACK@ (the active pack).
[Unit]
Description=Refresh the rag-stack knowledge base

[Service]
Type=oneshot
WorkingDirectory=@REPO@
Environment="PATH=@PATH@"
Environment="RAG_PACK=@PACK@"
ExecStart=/usr/bin/make refresh
# The API restarted after a promotion must outlive this unit.
KillMode=process
TimeoutStartSec=3h
Nice=10
