# Installed by docs/deployment.md, which fills in @REPO@ and @USER@ (a member of the docker group).
[Unit]
Description=Delete rag-stack conversations and traces past their retention period
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/docker compose run --rm --no-deps -T api python -m rag_stack.cli prune
