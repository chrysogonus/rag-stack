# The .env of a deployment (docs/deployment.md): copy to .env on the server and fill in every
# <...>. Generate each secret with `openssl rand -hex 32` (hex: they go into URLs unescaped).
# docker-compose.prod.yml refuses to start while a required one is missing.

# --- Compose ------------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=tracing
DOMAIN=<chat.example.com>
# The published image: ghcr.io/<GHCR_OWNER>/rag-stack:<IMAGE_TAG>. Never `latest`.
GHCR_OWNER=<github-user-or-org>
IMAGE_TAG=<0.1.0>
# Folder with impressum.html and datenschutz.html, e.g. a checkout of a private deploy repo.
LEGAL_PAGES_PATH=<path>

# --- LLM: an API with a key, never a personal subscription gateway --------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_API_KEY=<key of a project with a monthly budget limit>

# --- Limits for public, anonymous users ---------------------------------------------------
MAX_INPUT_CHARS=4000
MAX_HISTORY_MESSAGES=20
MAX_OUTPUT_TOKENS=4096
MAX_TURNS_PER_THREAD=50
RATE_LIMIT_PER_MINUTE=10
DAILY_TOKEN_BUDGET_PER_CLIENT=200000
DAILY_TOKEN_BUDGET_TOTAL=5000000

# --- Retention (`prune`, daily; keep the privacy policy in sync) ----------------------------
CONVERSATION_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30

# --- Knowledge base: the CPU models (the code defaults) -----------------------------------
QDRANT_COLLECTION=kb_chunks
RERANK_MIN_SCORE=0.0

# --- Ingestion (the weekly refresh) -------------------------------------------------------
FETCH_USER_AGENT=rag-stack/0.1 (AI-security knowledge base ingest)
NVD_API_KEY=<free key from nvd.nist.gov>
GITHUB_TOKEN=<fine-grained token with no permissions>

# --- Databases ----------------------------------------------------------------------------
POSTGRES_PASSWORD=<secret>

# --- Tracing: self-hosted Langfuse, reached only through an SSH tunnel to port 3000 --------
LANGFUSE_PUBLIC_KEY=pk-lf-<secret>
LANGFUSE_SECRET_KEY=sk-lf-<secret>
LANGFUSE_ADMIN_EMAIL=<you@example.com>
LANGFUSE_ADMIN_PASSWORD=<secret>
LANGFUSE_DISABLE_SIGNUP=true
LANGFUSE_POSTGRES_PASSWORD=<secret>
LANGFUSE_SALT=<secret>
LANGFUSE_ENCRYPTION_KEY=<secret: exactly 64 hex characters>
LANGFUSE_NEXTAUTH_SECRET=<secret>
LANGFUSE_CLICKHOUSE_PASSWORD=<secret>
LANGFUSE_REDIS_PASSWORD=<secret>
LANGFUSE_MINIO_PASSWORD=<secret>
